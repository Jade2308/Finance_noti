# ================================================================
# VN FINANCE HUB - CẤU HÌNH MÔI TRƯỜNG (.env)
# ================================================================

# --- 1. TELEGRAM BOT ---
# Lấy token từ @BotFather trên Telegram: gõ lệnh /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Lấy Chat ID: nhắn tin cho bot rồi mở https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# --- 2. GOOGLE GEMINI AI ---
# Tạo API key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# --- 3. LỊCH THÔNG BÁO TỰ ĐỘNG (Múi giờ Asia/Ho_Chi_Minh) ---
DAILY_REPORT_HOUR=18
DAILY_REPORT_MINUTE=0

# --- 4. CƠ SỞ DỮ LIỆU ---
DB_PATH=finance_hub.db
